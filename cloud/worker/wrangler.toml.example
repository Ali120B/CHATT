# Copy to wrangler.toml and fill in your ids.
name = "hearth-coordinator"
main = "src/index.ts"
compatibility_date = "2026-08-01"

[[d1_databases]]
binding = "DB"
database_name = "hearth-directory"
database_id = "PASTE-D1-ID"

[[r2_buckets]]
binding = "MAILBOX"
bucket_name = "hearth-mailbox"

[durable_objects]
bindings = [{ name = "SIGNALING", class_name = "Rendezvous" }]

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Rendezvous"]

[triggers]
crons = ["*/15 * * * *"]
