{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearth",
  "version": "1.2.0",
  "identifier": "org.hearth.chat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hearth",
        "width": 372,
        "height": 620,
        "minWidth": 300,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "focus": true
      }
    ],
    "trayIcon": { "iconPath": "icons/icon.png", "tooltip": "Hearth" },
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
